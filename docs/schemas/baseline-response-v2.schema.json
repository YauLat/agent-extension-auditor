        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "skill",
                  "plugin",
                  "mcpServer",
                  "hook",
                  "config",
                  "package"
                ]
              }
            },
            "required": [
              "name",
              "type"
            ],
            "additionalProperties": true
          }
        },
        "diff": {
          "anyOf": [
            {
              "$ref": "#/$defs/diff"
            },
            {
              "type": "null"
            }
          ]
        },
        "report": {
          "$ref": "scan-report-v2.schema.json"
        },
