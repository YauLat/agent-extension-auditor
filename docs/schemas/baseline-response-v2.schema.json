          "type": "object",
          "required": [
            "status",
            "generatedAt",
            "items"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "comparable",
                "partial",
                "incompatible",
                "unavailable"
              ]
            },
            "generatedAt": {
              "type": "string",
              "format": "date-time"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "itemId",
                  "state"
                ],
                "additionalProperties": false,
                "properties": {
                  "itemId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "state": {
                    "enum": [
                      "new",
                      "changed",
                      "unchanged",
                      "unknown"
                    ]
                  }
                }
              }
            }
          }
        }
      },
