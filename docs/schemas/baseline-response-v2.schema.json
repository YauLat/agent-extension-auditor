        "tool",
        "schemaVersion",
        "operation",
        "response",
        "exists",
        "reviewedHash",
        "canAccept",
        "assets",
        "diff"
      ],
      "additionalProperties": true,
      "dependentRequired": {
        "report": [
          "changeReview"
        ],
        "changeReview": [
          "report"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reviewedHash": {
                "type": "null"
              }
