{
  "name": "agent-extension-auditor",
  "version": "0.2.2",
  "description": "Local-first security auditor for AI agent skills, plugins, MCP servers, hooks, configs, and packages, with terminal and static HTML review interfaces.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YauLat/agent-extension-auditor.git"
  },
  "homepage": "https://github.com/YauLat/agent-extension-auditor#readme",
  "bugs": {
    "url": "https://github.com/YauLat/agent-extension-auditor/issues"
  },
  "type": "module",
  "bin": {
    "agent-audit": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "PRIVACY.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs",
    "rules",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "vitest run",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "keywords": [
    "agent",
    "audit",
    "mcp",
    "skills",
    "plugins",
    "security",
    "local-first",
    "ai-agents",
    "agent-security",
    "mcp-security",
    "macos",
    "swiftui"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.0.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "smol-toml": "1.9.0"
  }
}
